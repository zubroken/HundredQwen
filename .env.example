# 服务端口（默认 9010，当前固定使用这个）
SERVER_PORT=9010

# DeepSeek API 配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 默认模型
LLM_MODEL=deepseek-chat

# 科大讯飞星火（Spark）配置
# 模型可选: lite / max / x2 / x2-flash
SPARK_MODEL=lite
SPARK_API_KEY=your_spark_api_key_here
SPARK_API_SECRET=your_spark_api_secret_here
SPARK_APP_ID=your_spark_app_id_here

# 讯飞智文 PPT 生成配置
# 在讯飞开放平台开通"智能PPT生成"服务后获取
ZHIWEN_APP_ID=your_zhiwen_app_id_here
ZHIWEN_APP_SECRET=your_zhiwen_app_secret_here
